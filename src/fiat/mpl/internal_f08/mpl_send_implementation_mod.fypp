#:mute

#:set array_procs = [dict(name="REAL4", buf="PBUF", ftype="REAL", kind="JPRM", dims=":",   mpi_type="MPI_REAL4", dummy_name="ZDUM", dummy_decl="REAL(KIND=JPRM)    :: ZDUM(1:0)", zero_check=True, size_expr="SIZE(PBUF)"), dict(name="REAL8", buf="PBUF", ftype="REAL", kind="JPRD", dims=":",   mpi_type="MPI_REAL8", dummy_name="ZDUM", dummy_decl="REAL(KIND=JPRD)    :: ZDUM(1:0)", zero_check=True, size_expr="SIZE(PBUF)"), dict(name="INT",   buf="KBUF", ftype="INTEGER", kind="JPIM", dims=":",   mpi_type="MPI_INTEGER", dummy_name="IDUM", dummy_decl="INTEGER(KIND=JPIM) :: IDUM(1:0)", zero_check=True, size_expr="SIZE(KBUF)"), dict(name="REAL42", buf="PBUF", ftype="REAL", kind="JPRM", dims=":,:", mpi_type="MPI_REAL4", dummy_name="ZDUM", dummy_decl="REAL(KIND=JPRM)    :: ZDUM(1:0)", zero_check=True, size_expr="SIZE(PBUF)"), dict(name="REAL43", buf="PBUF", ftype="REAL", kind="JPRM", dims=":,:,:", mpi_type="MPI_REAL4", dummy_name="ZDUM", dummy_decl="", zero_check=False, size_expr="SIZE(PBUF)"), dict(name="REAL82", buf="PBUF", ftype="REAL", kind="JPRD", dims=":,:", mpi_type="MPI_REAL8", dummy_name="ZDUM", dummy_decl="REAL(KIND=JPRD)    :: ZDUM(1:0)", zero_check=True, size_expr="SIZE(PBUF)"), dict(name="REAL83", buf="PBUF", ftype="REAL", kind="JPRD", dims=":,:,:", mpi_type="MPI_REAL8", dummy_name="ZDUM", dummy_decl="", zero_check=False, size_expr="SIZE(PBUF)"), dict(name="INT2",  buf="KBUF", ftype="INTEGER", kind="JPIM", dims=":,:", mpi_type="MPI_INTEGER", dummy_name="IDUM", dummy_decl="INTEGER(KIND=JPIM) :: IDUM(1:0)", zero_check=True, size_expr="SIZE(KBUF)"), dict(name="INT8",  buf="KBUF", ftype="INTEGER", kind="JPIB", dims=":",   mpi_type="MPI_INTEGER8", dummy_name="IDUM", dummy_decl="INTEGER(KIND=JPIB) :: IDUM(1:0)", zero_check=True, size_expr="SIZE(KBUF)")]
#:set scalar_procs = [dict(name="INT_SCALAR", buf="KINT", ftype="INTEGER", kind="JPIM", mpi_type="MPI_INTEGER", size_expr="1"), dict(name="REAL4_SCALAR", buf="PBUF", ftype="REAL", kind="JPRM", mpi_type="MPI_REAL4", size_expr="1"), dict(name="REAL8_SCALAR", buf="PBUF", ftype="REAL", kind="JPRD", mpi_type="MPI_REAL8", size_expr="1")]

#:endmute

SUBMODULE (MPL_SEND_MOD) MPL_SEND_IMPLEMENTATION_MOD

USE EC_PARKIND, ONLY : JPRD, JPIM, JPIB, JPRM
USE OML_MOD,    ONLY : OML_MY_THREAD

USE MPL_MPI,         ONLY : MPI_COMM, MPI_REQUEST, MPI_REAL4, MPI_REAL8, MPI_INTEGER, MPI_INTEGER8, MPI_BYTE, &
 &                          MPI_SEND, MPI_ISEND, MPI_BSEND, MPI_IBSEND, MPI_SSEND
USE MPL_DATA_MODULE, ONLY : MPL_OUTPUT, MPL_COMM_OML, MPL_ERRUNIT, MPL_UNIT, MPL_METHOD, MPL_NUMPROC, &
 &                          JP_BLOCKING_STANDARD, JP_BLOCKING_BUFFERED, JP_BLOCKING_SYNCHRONOUS, &
 &                          JP_NON_BLOCKING_STANDARD, JP_NON_BLOCKING_BUFFERED
USE MPL_MESSAGE_MOD, ONLY : MPL_MESSAGE
USE MPL_NPROC_MOD,   ONLY : MPL_NPROC
USE MPL_STATS_MOD,   ONLY : MPL_SENDSTATS
USE YOMMPLSTATS,     ONLY : LMPLSTATS

IMPLICIT NONE

CONTAINS

! array variants
#:for proc in array_procs
MODULE PROCEDURE MPL_SEND_${proc["name"]}$

#ifdef USE_8_BYTE_WORDS
  USE MPI4TO8, ONLY : &
    MPI_SEND => MPI_SEND8, MPI_BSEND => MPI_BSEND8, MPI_ISEND => MPI_ISEND8
#endif

TYPE(MPI_REQUEST)  :: IREQUEST_LOCAL
INTEGER(KIND=JPIM) :: ICOUNT,IMP_TYPE,IERROR
TYPE(MPI_COMM)     :: ICOMM
LOGICAL :: LLABORT=.TRUE.
INTEGER(KIND=JPIM) :: ITID
#:if proc["dummy_decl"]
${proc["dummy_decl"]}$
#:endif
ITID = OML_MY_THREAD()

IF(MPL_NUMPROC < 1) CALL MPL_MESSAGE( &
  & CDMESSAGE='MPL_SEND: MPL NOT INITIALISED ',LDABORT=LLABORT)

IF(PRESENT(KMP_TYPE)) THEN
  IMP_TYPE=KMP_TYPE
ELSE
  IMP_TYPE=MPL_METHOD
ENDIF
IF(PRESENT(KCOMM)) THEN
  ICOMM%MPI_VAL=KCOMM
ELSE
  ICOMM%MPI_VAL=MPL_COMM_OML(ITID)
ENDIF
IF((KDEST < 1 .OR. KDEST >MPL_NPROC(ICOMM%MPI_VAL)) .AND. (.NOT. PRESENT (KCOMM))) THEN
  WRITE(MPL_ERRUNIT,*)'MPL_SEND: ERROR KDEST=',KDEST
  CALL MPL_MESSAGE(CDMESSAGE='MPL_SEND:ILLEGAL KDEST ',LDABORT=LLABORT)
ENDIF

ICOUNT = ${proc["size_expr"]}$
#ifdef MPL_CHECK_CONTIG
IF( .NOT. IS_CONTIGUOUS(${proc["buf"]}$) ) THEN
  CALL MPL_MESSAGE(CDMESSAGE='MPL_SEND: BUFFER NOT CONTIGUOUS ',LDABORT=LLABORT)
ENDIF
#endif

IF(LMPLSTATS) THEN
  CALL MPL_SENDSTATS(ICOUNT,${proc["mpi_type"]}$%MPI_VAL)
ENDIF

#:if proc["zero_check"]
IF (ICOUNT == 0) THEN
  IF(IMP_TYPE == JP_BLOCKING_STANDARD) THEN
    CALL MPI_SEND(${proc["dummy_name"]}$,ICOUNT,${proc["mpi_type"]}$,KDEST-1,KTAG,ICOMM,IERROR)
  ELSE IF(IMP_TYPE == JP_BLOCKING_BUFFERED) THEN
    CALL MPI_BSEND(${proc["dummy_name"]}$,ICOUNT,${proc["mpi_type"]}$,KDEST-1,KTAG,ICOMM,IERROR)
  ELSE IF(IMP_TYPE == JP_NON_BLOCKING_STANDARD) THEN
    CALL MPI_ISEND(${proc["dummy_name"]}$,ICOUNT,${proc["mpi_type"]}$,KDEST-1,KTAG,ICOMM, &
      & IREQUEST_LOCAL,IERROR)
    KREQUEST=IREQUEST_LOCAL%MPI_VAL
  ELSE IF(IMP_TYPE == JP_NON_BLOCKING_BUFFERED) THEN
    CALL MPI_IBSEND(${proc["dummy_name"]}$,ICOUNT,${proc["mpi_type"]}$,KDEST-1,KTAG,ICOMM, &
      & IREQUEST_LOCAL,IERROR)
    KREQUEST=IREQUEST_LOCAL%MPI_VAL
  ELSE IF(IMP_TYPE == JP_BLOCKING_SYNCHRONOUS) THEN
    CALL MPI_SSEND(${proc["dummy_name"]}$,ICOUNT,${proc["mpi_type"]}$,KDEST-1,KTAG,ICOMM,IERROR)
  ELSE
    IF(PRESENT(KERROR)) THEN
      KERROR=1
    ELSE
      CALL MPL_MESSAGE(CDMESSAGE='MPL_SEND',CDSTRING=' INVALID METHOD',KERROR=KERROR,LDABORT=LLABORT)
    ENDIF
  ENDIF
ELSE
#:endif
  IF(IMP_TYPE == JP_BLOCKING_STANDARD) THEN
    CALL MPI_SEND(${proc["buf"]}$,ICOUNT,${proc["mpi_type"]}$,KDEST-1,KTAG,ICOMM,IERROR)
  ELSE IF(IMP_TYPE == JP_BLOCKING_BUFFERED) THEN
    CALL MPI_BSEND(${proc["buf"]}$,ICOUNT,${proc["mpi_type"]}$,KDEST-1,KTAG,ICOMM,IERROR)
  ELSE IF(IMP_TYPE == JP_NON_BLOCKING_STANDARD) THEN
    CALL MPI_ISEND(${proc["buf"]}$,ICOUNT,${proc["mpi_type"]}$,KDEST-1,KTAG,ICOMM, &
      & IREQUEST_LOCAL,IERROR)
    KREQUEST=IREQUEST_LOCAL%MPI_VAL
  ELSE IF(IMP_TYPE == JP_NON_BLOCKING_BUFFERED) THEN
    CALL MPI_IBSEND(${proc["buf"]}$,ICOUNT,${proc["mpi_type"]}$,KDEST-1,KTAG,ICOMM, &
      & IREQUEST_LOCAL,IERROR)
    KREQUEST=IREQUEST_LOCAL%MPI_VAL
  ELSE IF(IMP_TYPE == JP_BLOCKING_SYNCHRONOUS) THEN
    CALL MPI_SSEND(${proc["buf"]}$,ICOUNT,${proc["mpi_type"]}$,KDEST-1,KTAG,ICOMM,IERROR)
  ELSE
    IF(PRESENT(KERROR)) THEN
      KERROR=1
    ELSE
      CALL MPL_MESSAGE(CDMESSAGE='MPL_SEND',CDSTRING=' INVALID METHOD',KERROR=KERROR,LDABORT=LLABORT)
    ENDIF
  ENDIF
#:if proc["zero_check"]
ENDIF
#:endif
IF(MPL_OUTPUT > 1 )THEN
  WRITE(MPL_UNIT,'(A,5I8)') ' MPL_SEND ',ICOUNT,IMP_TYPE,KDEST,KTAG,ICOMM
ENDIF
IF(PRESENT(KERROR)) THEN
  KERROR=IERROR
ELSE
  IF(IERROR /= 0 ) CALL MPL_MESSAGE(CDMESSAGE='MPL_SEND',CDSTRING=CDSTRING,KERROR=IERROR,LDABORT=LLABORT)
ENDIF

END PROCEDURE MPL_SEND_${proc["name"]}$

#:endfor

! scalar variants
#:for proc in scalar_procs
MODULE PROCEDURE MPL_SEND_${proc["name"]}$

#ifdef USE_8_BYTE_WORDS
  USE MPI4TO8, ONLY : &
    MPI_SEND => MPI_SEND8, MPI_BSEND => MPI_BSEND8, MPI_ISEND => MPI_ISEND8
#endif

TYPE(MPI_REQUEST)  :: IREQUEST_LOCAL
INTEGER(KIND=JPIM) :: ICOUNT,IMP_TYPE,IERROR
TYPE(MPI_COMM)     :: ICOMM
LOGICAL :: LLABORT=.TRUE.
INTEGER(KIND=JPIM) :: ITID
ITID = OML_MY_THREAD()

IF(MPL_NUMPROC < 1) CALL MPL_MESSAGE( &
  & CDMESSAGE='MPL_SEND: MPL NOT INITIALISED ',LDABORT=LLABORT)

IF(PRESENT(KMP_TYPE)) THEN
  IMP_TYPE=KMP_TYPE
ELSE
  IMP_TYPE=MPL_METHOD
ENDIF
IF(PRESENT(KCOMM)) THEN
  ICOMM%MPI_VAL=KCOMM
ELSE
  ICOMM%MPI_VAL=MPL_COMM_OML(ITID)
ENDIF
IF((KDEST < 1 .OR. KDEST >MPL_NPROC(ICOMM%MPI_VAL)) .AND. (.NOT. PRESENT (KCOMM))) THEN
  WRITE(MPL_ERRUNIT,*)'MPL_SEND: ERROR KDEST=',KDEST
  CALL MPL_MESSAGE(CDMESSAGE='MPL_SEND:ILLEGAL KDEST ',LDABORT=LLABORT)
ENDIF

ICOUNT = ${proc["size_expr"]}$

IF(LMPLSTATS) THEN
  CALL MPL_SENDSTATS(ICOUNT,${proc["mpi_type"]}$%MPI_VAL)
ENDIF

IF(IMP_TYPE == JP_BLOCKING_STANDARD) THEN
  CALL MPI_SEND(${proc["buf"]}$,ICOUNT,${proc["mpi_type"]}$,KDEST-1,KTAG,ICOMM,IERROR)
ELSE IF(IMP_TYPE == JP_BLOCKING_BUFFERED) THEN
  CALL MPI_BSEND(${proc["buf"]}$,ICOUNT,${proc["mpi_type"]}$,KDEST-1,KTAG,ICOMM,IERROR)
ELSE IF(IMP_TYPE == JP_NON_BLOCKING_STANDARD) THEN
  CALL MPI_ISEND(${proc["buf"]}$,ICOUNT,${proc["mpi_type"]}$,KDEST-1,KTAG,ICOMM, &
    & IREQUEST_LOCAL,IERROR)
  KREQUEST=IREQUEST_LOCAL%MPI_VAL
ELSE IF(IMP_TYPE == JP_NON_BLOCKING_BUFFERED) THEN
  CALL MPI_IBSEND(${proc["buf"]}$,ICOUNT,${proc["mpi_type"]}$,KDEST-1,KTAG,ICOMM, &
    & IREQUEST_LOCAL,IERROR)
  KREQUEST=IREQUEST_LOCAL%MPI_VAL
ELSE IF(IMP_TYPE == JP_BLOCKING_SYNCHRONOUS) THEN
  CALL MPI_SSEND(${proc["buf"]}$,ICOUNT,${proc["mpi_type"]}$,KDEST-1,KTAG,ICOMM,IERROR)
ELSE
  IF(PRESENT(KERROR)) THEN
    KERROR=1
  ELSE
    CALL MPL_MESSAGE(CDMESSAGE='MPL_SEND',CDSTRING=' INVALID METHOD',KERROR=KERROR,LDABORT=LLABORT)
  ENDIF
ENDIF
IF(MPL_OUTPUT > 1 )THEN
  WRITE(MPL_UNIT,'(A,5I8)') ' MPL_SEND ',ICOUNT,IMP_TYPE,KDEST,KTAG,ICOMM
ENDIF
IF(PRESENT(KERROR)) THEN
  KERROR=IERROR
ELSE
  IF(IERROR /= 0 ) CALL MPL_MESSAGE(CDMESSAGE='MPL_SEND',CDSTRING=CDSTRING,KERROR=IERROR,LDABORT=LLABORT)
ENDIF

END PROCEDURE MPL_SEND_${proc["name"]}$

#:endfor

MODULE PROCEDURE MPL_SEND_CHAR_SCALAR

#ifdef USE_8_BYTE_WORDS
  USE MPI4TO8, ONLY : &
    MPI_SEND => MPI_SEND8, MPI_BSEND => MPI_BSEND8, MPI_ISEND => MPI_ISEND8
#endif

TYPE(MPI_REQUEST)  :: IREQUEST_LOCAL
INTEGER(KIND=JPIM) :: ICOUNT,IMP_TYPE,IERROR
TYPE(MPI_COMM)     :: ICOMM
LOGICAL :: LLABORT=.TRUE.
INTEGER(KIND=JPIM) :: ITID
ITID = OML_MY_THREAD()

IF(MPL_NUMPROC < 1) CALL MPL_MESSAGE( &
  & CDMESSAGE='MPL_SEND: MPL NOT INITIALISED ',LDABORT=LLABORT)

IF(PRESENT(KMP_TYPE)) THEN
  IMP_TYPE=KMP_TYPE
ELSE
  IMP_TYPE=MPL_METHOD
ENDIF
IF(PRESENT(KCOMM)) THEN
  ICOMM%MPI_VAL=KCOMM
ELSE
  ICOMM%MPI_VAL=MPL_COMM_OML(ITID)
ENDIF
IF((KDEST < 1 .OR. KDEST >MPL_NPROC(ICOMM%MPI_VAL)) .AND. (.NOT. PRESENT (KCOMM))) THEN
  WRITE(MPL_ERRUNIT,*)'MPL_SEND: ERROR KDEST=',KDEST
  CALL MPL_MESSAGE(CDMESSAGE='MPL_SEND:ILLEGAL KDEST ',LDABORT=LLABORT)
ENDIF

ICOUNT = LEN(CDCHAR)

IF(LMPLSTATS) THEN
  CALL MPL_SENDSTATS(ICOUNT,MPI_BYTE%MPI_VAL)
ENDIF

IF(IMP_TYPE == JP_BLOCKING_STANDARD) THEN
  CALL MPI_SEND(CDCHAR,ICOUNT,MPI_BYTE,KDEST-1,KTAG,ICOMM,IERROR)
ELSE IF(IMP_TYPE == JP_BLOCKING_BUFFERED) THEN
  CALL MPI_BSEND(CDCHAR,ICOUNT,MPI_BYTE,KDEST-1,KTAG,ICOMM,IERROR)
ELSE IF(IMP_TYPE == JP_NON_BLOCKING_STANDARD) THEN
  CALL MPI_ISEND(CDCHAR,ICOUNT,MPI_BYTE,KDEST-1,KTAG,ICOMM, &
    & IREQUEST_LOCAL,IERROR)
  KREQUEST=IREQUEST_LOCAL%MPI_VAL
ELSE IF(IMP_TYPE == JP_NON_BLOCKING_BUFFERED) THEN
  CALL MPI_IBSEND(CDCHAR,ICOUNT,MPI_BYTE,KDEST-1,KTAG,ICOMM, &
    & IREQUEST_LOCAL,IERROR)
  KREQUEST=IREQUEST_LOCAL%MPI_VAL
ELSE IF(IMP_TYPE == JP_BLOCKING_SYNCHRONOUS) THEN
  CALL MPI_SSEND(CDCHAR,ICOUNT,MPI_BYTE,KDEST-1,KTAG,ICOMM,IERROR)
ELSE
  IF(PRESENT(KERROR)) THEN
    KERROR=1
  ELSE
    CALL MPL_MESSAGE(CDMESSAGE='MPL_SEND',CDSTRING=' INVALID METHOD',KERROR=KERROR,LDABORT=LLABORT)
  ENDIF
ENDIF
IF(MPL_OUTPUT > 1 )THEN
  WRITE(MPL_UNIT,'(A,5I8)') ' MPL_SEND ',ICOUNT,IMP_TYPE,KDEST,KTAG,ICOMM
ENDIF
IF(PRESENT(KERROR)) THEN
  KERROR=IERROR
ELSE
  IF(IERROR /= 0 ) CALL MPL_MESSAGE(CDMESSAGE='MPL_SEND',CDSTRING=CDSTRING,KERROR=IERROR,LDABORT=LLABORT)
ENDIF

END PROCEDURE MPL_SEND_CHAR_SCALAR

MODULE PROCEDURE MPL_SEND_CHAR

#ifdef USE_8_BYTE_WORDS
  USE MPI4TO8, ONLY : &
    MPI_SEND => MPI_SEND8, MPI_BSEND => MPI_BSEND8, MPI_ISEND => MPI_ISEND8
#endif

TYPE(MPI_REQUEST)  :: IREQUEST_LOCAL
INTEGER(KIND=JPIM) :: ICOUNT,IMP_TYPE,IERROR
TYPE(MPI_COMM)     :: ICOMM
LOGICAL            :: LLABORT=.TRUE.
INTEGER(KIND=JPIM) :: ITID
ITID = OML_MY_THREAD()

IF(MPL_NUMPROC < 1) CALL MPL_MESSAGE( &
  & CDMESSAGE='MPL_SEND: MPL NOT INITIALISED ',LDABORT=LLABORT)

IF(PRESENT(KMP_TYPE)) THEN
  IMP_TYPE=KMP_TYPE
ELSE
  IMP_TYPE=MPL_METHOD
ENDIF
IF(PRESENT(KCOMM)) THEN
  ICOMM%MPI_VAL=KCOMM
ELSE
  ICOMM%MPI_VAL=MPL_COMM_OML(ITID)
ENDIF
IF((KDEST < 1 .OR. KDEST >MPL_NPROC(ICOMM%MPI_VAL)) .AND. (.NOT. PRESENT (KCOMM))) THEN
  WRITE(MPL_ERRUNIT,*)'MPL_SEND: ERROR KDEST=',KDEST
  CALL MPL_MESSAGE(CDMESSAGE='MPL_SEND:ILLEGAL KDEST ',LDABORT=LLABORT)
ENDIF

ICOUNT = LEN(CDCHAR) * SIZE(CDCHAR)

IF(LMPLSTATS) THEN
  CALL MPL_SENDSTATS(ICOUNT,MPI_BYTE%MPI_VAL)
ENDIF

IF(IMP_TYPE == JP_BLOCKING_STANDARD) THEN
  CALL MPI_SEND(CDCHAR,ICOUNT,MPI_BYTE,KDEST-1,KTAG,ICOMM,IERROR)
ELSE IF(IMP_TYPE == JP_BLOCKING_BUFFERED) THEN
  CALL MPI_BSEND(CDCHAR,ICOUNT,MPI_BYTE,KDEST-1,KTAG,ICOMM,IERROR)
ELSE IF(IMP_TYPE == JP_NON_BLOCKING_STANDARD) THEN
  CALL MPI_ISEND(CDCHAR,ICOUNT,MPI_BYTE,KDEST-1,KTAG,ICOMM, &
    & IREQUEST_LOCAL,IERROR)
  KREQUEST=IREQUEST_LOCAL%MPI_VAL
ELSE IF(IMP_TYPE == JP_NON_BLOCKING_BUFFERED) THEN
  CALL MPI_IBSEND(CDCHAR,ICOUNT,MPI_BYTE,KDEST-1,KTAG,ICOMM, &
    & IREQUEST_LOCAL,IERROR)
  KREQUEST=IREQUEST_LOCAL%MPI_VAL
ELSE IF(IMP_TYPE == JP_BLOCKING_SYNCHRONOUS) THEN
  CALL MPI_SSEND(CDCHAR,ICOUNT,MPI_BYTE,KDEST-1,KTAG,ICOMM,IERROR)
ELSE
  IF(PRESENT(KERROR)) THEN
    KERROR=1
  ELSE
    CALL MPL_MESSAGE(CDMESSAGE='MPL_SEND',CDSTRING=' INVALID METHOD',KERROR=KERROR,LDABORT=LLABORT)
  ENDIF
ENDIF
IF(MPL_OUTPUT > 1 )THEN
  WRITE(MPL_UNIT,'(A,5I8)') ' MPL_SEND ',ICOUNT,IMP_TYPE,KDEST,KTAG,ICOMM
ENDIF
IF(PRESENT(KERROR)) THEN
  KERROR=IERROR
ELSE
  IF(IERROR /= 0 ) CALL MPL_MESSAGE(CDMESSAGE='MPL_SEND',CDSTRING=CDSTRING,KERROR=IERROR,LDABORT=LLABORT)
ENDIF

END PROCEDURE MPL_SEND_CHAR

END SUBMODULE MPL_SEND_IMPLEMENTATION_MOD
