SUBMODULE (MPL_ALLTOALLV_MOD) MPL_ALLTOALLV_IMPLEMENTATION_MOD

USE EC_PARKIND, ONLY : JPRD, JPIM, JPIB, JPRM
USE OML_MOD,    ONLY : OML_MY_THREAD

USE MPL_MPI,         ONLY : MPI_COMM, MPI_REQUEST, MPI_REAL8, MPI_REAL4, MPI_INTEGER, MPI_ALLTOALLV, MPI_IALLTOALLV
USE MPL_DATA_MODULE, ONLY : MPL_COMM_OML, MPL_OUTPUT, MPL_UNIT, MPL_METHOD, MPL_NUMPROC, &
 &                          JP_BLOCKING_STANDARD, JP_BLOCKING_BUFFERED, JP_NON_BLOCKING_STANDARD, JP_NON_BLOCKING_BUFFERED
USE MPL_STATS_MOD,   ONLY : MPL_RECVSTATS, MPL_SENDSTATS
USE YOMMPLSTATS,     ONLY : LMPLSTATS
USE MPL_MESSAGE_MOD, ONLY : MPL_MESSAGE
USE MPL_DISPLS_CONTAINER_MOD, ONLY : YDDISPLS_LIST

IMPLICIT NONE

CONTAINS

SUBROUTINE MPL_ALLTOALLV_PREAMB(KSENDCOUNTS,KISENDDISPL,KISENDDISPL_PT,&
  & KRECVDISPL,KIRECVDISPL,KIRECVDISPL_PT,CDSTRING)

INTEGER(KIND=JPIM),INTENT(IN) :: KSENDCOUNTS(:)
INTEGER(KIND=JPIM),ALLOCATABLE,TARGET,INTENT(INOUT) :: KISENDDISPL(:)
INTEGER(KIND=JPIM),POINTER,INTENT(INOUT) :: KISENDDISPL_PT(:)
INTEGER(KIND=JPIM),INTENT(IN),OPTIONAL, TARGET :: KRECVDISPL(:)
INTEGER(KIND=JPIM),ALLOCATABLE,TARGET,INTENT(INOUT) :: KIRECVDISPL(:)
INTEGER(KIND=JPIM),POINTER,INTENT(INOUT) :: KIRECVDISPL_PT(:)
CHARACTER(LEN=*),INTENT(IN),OPTIONAL :: CDSTRING

INTEGER(KIND=JPIM) :: I
LOGICAL :: LLABORT=.TRUE.

IF(ANY(KSENDCOUNTS < 0)) THEN
  CALL MPL_MESSAGE(CDMESSAGE='MPL_ALLTOALLV: KSENDCOUNTS contains <0 counts',LDABORT=LLABORT)
ENDIF

ALLOCATE(KISENDDISPL(MPL_NUMPROC))
KISENDDISPL(1) = 0
DO I = 2,MPL_NUMPROC
  KISENDDISPL(I) = KISENDDISPL(I-1) + KSENDCOUNTS(I-1)
END DO
KISENDDISPL_PT => KISENDDISPL

IF(PRESENT(KRECVDISPL)) THEN
  ALLOCATE(KIRECVDISPL(SIZE(KRECVDISPL)))
  KIRECVDISPL = KRECVDISPL
  KIRECVDISPL_PT => KIRECVDISPL
ELSE
  ALLOCATE(KIRECVDISPL(MPL_NUMPROC))
  KIRECVDISPL(1) = 0
  DO I = 2,MPL_NUMPROC
    KIRECVDISPL(I) = KIRECVDISPL(I-1) + KSENDCOUNTS(I-1)
  END DO
  KIRECVDISPL_PT => KIRECVDISPL
ENDIF

END SUBROUTINE MPL_ALLTOALLV_PREAMB

#:mute
#:set procs = [dict(name="REAL8", sendbuf="PSENDBUF", recvbuf="PRECVBUF", mpi_type="MPI_REAL8", stats_type="MPI_REAL8"), dict(name="REAL4", sendbuf="PSENDBUF", recvbuf="PRECVBUF", mpi_type="MPI_REAL4", stats_type="MPI_REAL4"), dict(name="INTEGER", sendbuf="KSENDBUF", recvbuf="KRECVBUF", mpi_type="MPI_INTEGER", stats_type="MPI_INTEGER")]
#:endmute

#:for proc in procs
MODULE PROCEDURE MPL_ALLTOALLV_${proc["name"]}$

INTEGER(KIND=JPIM) :: IERROR
INTEGER(KIND=JPIM) :: IMP_TYPE
INTEGER(KIND=JPIM) :: ITID
TYPE(MPI_COMM)     :: ICOMM
TYPE(MPI_REQUEST)  :: IREQUEST_LOCAL
INTEGER(KIND=JPIM),ALLOCATABLE,TARGET :: ISENDDISPL(:)
INTEGER(KIND=JPIM),POINTER :: ISENDDISPL_PT(:)
INTEGER(KIND=JPIM),ALLOCATABLE,TARGET :: IRECVDISPL(:)
INTEGER(KIND=JPIM),POINTER :: IRECVDISPL_PT(:)
LOGICAL :: LLABORT=.TRUE.

ITID = OML_MY_THREAD()
IF(PRESENT(KCOMM)) THEN
  ICOMM%MPI_VAL = KCOMM
ELSE
  ICOMM%MPI_VAL = MPL_COMM_OML(ITID)
ENDIF

IF(PRESENT(KMP_TYPE)) THEN
  IMP_TYPE = KMP_TYPE
ELSE
  IMP_TYPE = MPL_METHOD
ENDIF

CALL MPL_ALLTOALLV_PREAMB(KSENDCOUNTS,ISENDDISPL,ISENDDISPL_PT,KRECVDISPL,IRECVDISPL,IRECVDISPL_PT,CDSTRING)

IF(IMP_TYPE == JP_BLOCKING_STANDARD .OR. IMP_TYPE == JP_BLOCKING_BUFFERED) THEN
  CALL MPI_ALLTOALLV(${proc["sendbuf"]}$,KSENDCOUNTS,ISENDDISPL_PT,${proc["mpi_type"]}$,${proc["recvbuf"]}$,KRECVCOUNTS,IRECVDISPL_PT,${proc["mpi_type"]}$,ICOMM,IERROR)
ELSEIF(IMP_TYPE == JP_NON_BLOCKING_STANDARD .OR. IMP_TYPE == JP_NON_BLOCKING_BUFFERED) THEN
  CALL MPI_IALLTOALLV(${proc["sendbuf"]}$,KSENDCOUNTS,ISENDDISPL_PT,${proc["mpi_type"]}$,${proc["recvbuf"]}$,KRECVCOUNTS,IRECVDISPL_PT,${proc["mpi_type"]}$,ICOMM,IREQUEST_LOCAL,IERROR)
  KREQUEST=IREQUEST_LOCAL%MPI_VAL
  IF(.NOT. PRESENT(KRECVDISPL)) THEN
    CALL YDDISPLS_LIST%APPEND(KREQ=KREQUEST,NO_NEW_NODE=.TRUE.)
  ENDIF
ENDIF

IF(LMPLSTATS) THEN
  CALL MPL_SENDSTATS(SUM(KSENDCOUNTS),${proc["stats_type"]}$%MPI_VAL)
  CALL MPL_RECVSTATS(SUM(KRECVCOUNTS),${proc["stats_type"]}$%MPI_VAL)
ENDIF

IF(MPL_OUTPUT > 1 )THEN
  WRITE(MPL_UNIT,'(A,5I8)') ' MPL_ALLTOALLV ',SUM(KSENDCOUNTS),SUM(KRECVCOUNTS),ICOMM
ENDIF
IF(PRESENT(KERROR)) THEN
  KERROR=IERROR
ELSE
  IF(IERROR /= 0 ) CALL MPL_MESSAGE(CDMESSAGE='MPL_ALLTOALLV',CDSTRING=CDSTRING,KERROR=IERROR,LDABORT=LLABORT)
ENDIF

END PROCEDURE MPL_ALLTOALLV_${proc["name"]}$

#:endfor

END SUBMODULE MPL_ALLTOALLV_IMPLEMENTATION_MOD
