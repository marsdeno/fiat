SUBMODULE (MPL_SCATTERV_MOD) MPL_SCATTERV_IMPLEMENTATION_MOD

USE EC_PARKIND, ONLY : JPRD, JPIM, JPRM
USE OML_MOD,    ONLY : OML_MY_THREAD

USE MPL_MPI,         ONLY : MPI_COMM, MPI_REQUEST, MPI_REAL8, MPI_REAL4, MPI_INTEGER, MPI_SCATTERV, MPI_ISCATTERV, &
 &                          MPI_GATHER, MPI_GATHERV
USE MPL_DATA_MODULE, ONLY : MPL_COMM_OML, MPL_OUTPUT, MPL_UNIT, MPL_METHOD, MPL_NUMPROC, &
 &                          JP_BLOCKING_STANDARD, JP_BLOCKING_BUFFERED, JP_NON_BLOCKING_STANDARD, JP_NON_BLOCKING_BUFFERED
USE MPL_STATS_MOD,   ONLY : MPL_RECVSTATS, MPL_SENDSTATS
USE YOMMPLSTATS,     ONLY : LMPLSTATS
USE MPL_MESSAGE_MOD, ONLY : MPL_MESSAGE
USE MPL_DISPLS_CONTAINER_MOD, ONLY : YDDISPLS_LIST

IMPLICIT NONE

CONTAINS

SUBROUTINE MPL_SCATTERV_PREAMB1(ICOMM,IROOT,IMP_TYPE,KCOMM,KROOT,KMP_TYPE,KREQUEST)
TYPE(MPI_COMM),INTENT(OUT) :: ICOMM
INTEGER(KIND=JPIM),INTENT(OUT) :: IROOT,IMP_TYPE
INTEGER(KIND=JPIM),INTENT(IN),OPTIONAL :: KCOMM,KROOT,KMP_TYPE,KREQUEST

INTEGER(KIND=JPIM) :: ITID
LOGICAL :: LLABORT=.TRUE.

ITID = OML_MY_THREAD()

IF(MPL_NUMPROC < 1) CALL MPL_MESSAGE(&
  & CDMESSAGE='MPL_SCATTERV: MPL NOT INITIALISED ',LDABORT=LLABORT)

IF(PRESENT(KCOMM)) THEN
  ICOMM%MPI_VAL=KCOMM
ELSE
  ICOMM%MPI_VAL=MPL_COMM_OML(ITID)
ENDIF

IF(PRESENT(KROOT)) THEN
  IROOT=KROOT
ELSE
  IROOT=1
ENDIF

IF(IROOT < 1 .OR. IROOT > MPL_NUMPROC) THEN
  CALL MPL_MESSAGE(CDMESSAGE='MPL_SCATTERV: ILLEGAL KROOT ',LDABORT=LLABORT)
ENDIF

IF(PRESENT(KMP_TYPE)) THEN
  IMP_TYPE=KMP_TYPE
ELSE
  IMP_TYPE=MPL_METHOD
ENDIF

IF(IMP_TYPE == JP_NON_BLOCKING_STANDARD .AND. (.NOT. PRESENT(KREQUEST))) THEN
  CALL MPL_MESSAGE(CDMESSAGE='MPL_SCATTERV:KREQUEST MISSING ',LDABORT=LLABORT)
ENDIF

END SUBROUTINE MPL_SCATTERV_PREAMB1

SUBROUTINE MPL_SCATTERV_PREAMB2(KSENDCOUNTS,KISENDDISPL,KSENDDISPL,KISENDDISPL_PT,CDSTRING)

INTEGER(KIND=JPIM),INTENT(IN),OPTIONAL :: KSENDCOUNTS(:)
INTEGER(KIND=JPIM),INTENT(IN),OPTIONAL,TARGET :: KSENDDISPL(:)
INTEGER(KIND=JPIM),ALLOCATABLE,TARGET,INTENT(INOUT) :: KISENDDISPL(:)
INTEGER(KIND=JPIM),POINTER,INTENT(INOUT) :: KISENDDISPL_PT(:)
CHARACTER(LEN=*),INTENT(IN),OPTIONAL :: CDSTRING

INTEGER(KIND=JPIM) :: I
LOGICAL :: LLABORT=.TRUE.

IF(PRESENT(KSENDCOUNTS)) THEN
  IF(ANY(KSENDCOUNTS < 0)) THEN
    CALL MPL_MESSAGE(CDMESSAGE='MPL_SCATTERV: KSENDCOUNTS contains <0 counts',LDABORT=LLABORT)
  ENDIF
ENDIF

IF(PRESENT(KSENDDISPL)) THEN
  ALLOCATE(KISENDDISPL(SIZE(KSENDDISPL)))
  KISENDDISPL = KSENDDISPL
  KISENDDISPL_PT => KISENDDISPL
ELSE
  ALLOCATE(KISENDDISPL(MPL_NUMPROC))
  KISENDDISPL(1) = 0
  IF(PRESENT(KSENDCOUNTS)) THEN
    DO I = 2,MPL_NUMPROC
      KISENDDISPL(I) = KISENDDISPL(I-1) + KSENDCOUNTS(I-1)
    END DO
  ENDIF
  KISENDDISPL_PT => KISENDDISPL
ENDIF

END SUBROUTINE MPL_SCATTERV_PREAMB2

#:mute
#:set procs = [dict(name="REAL8", sendbuf="PSENDBUF", recvbuf="PRECVBUF", recv_size="SIZE(PRECVBUF)", mpi_type="MPI_REAL8", stats_type="MPI_REAL8"), dict(name="REAL4", sendbuf="PSENDBUF", recvbuf="PRECVBUF", recv_size="SIZE(PRECVBUF)", mpi_type="MPI_REAL4", stats_type="MPI_REAL4"), dict(name="INTEGER", sendbuf="KSENDBUF", recvbuf="KRECVBUF", recv_size="SIZE(KRECVBUF)", mpi_type="MPI_INTEGER", stats_type="MPI_INTEGER")]
#:endmute

#:for proc in procs
MODULE PROCEDURE MPL_SCATTERV_${proc["name"]}$

INTEGER(KIND=JPIM) :: IERROR,ISENDCOUNT,IRECVCOUNT
TYPE(MPI_COMM)     :: ICOMM
TYPE(MPI_REQUEST)  :: IREQUEST_LOCAL
INTEGER(KIND=JPIM) :: IROOT,IMP_TYPE
INTEGER(KIND=JPIM),ALLOCATABLE :: IRECVDISPL(:)
INTEGER(KIND=JPIM),POINTER :: IRECVDISPL_PT(:)
INTEGER(KIND=JPIM),ALLOCATABLE,TARGET :: ISENDCOUNTS(:)
INTEGER(KIND=JPIM),ALLOCATABLE,TARGET :: ISENDDISPL(:)
INTEGER(KIND=JPIM),POINTER :: ISENDDISPL_PT(:)
LOGICAL :: LLABORT=.TRUE.

CALL MPL_SCATTERV_PREAMB1(ICOMM,IROOT,IMP_TYPE,KCOMM,KROOT,KMP_TYPE,KREQUEST)

IRECVCOUNT = ${proc["recv_size"]}$
IF(PRESENT(KSENDCOUNTS)) THEN
  ISENDCOUNTS = KSENDCOUNTS
  ISENDCOUNT = SUM(KSENDCOUNTS)
ELSE
  ISENDCOUNT = IRECVCOUNT
ENDIF

CALL MPL_SCATTERV_PREAMB2(KSENDCOUNTS,ISENDDISPL,KSENDDISPL,ISENDDISPL_PT,CDSTRING)

IF(IMP_TYPE == JP_BLOCKING_STANDARD .OR. IMP_TYPE == JP_BLOCKING_BUFFERED) THEN
  CALL MPI_SCATTERV(${proc["sendbuf"]}$,ISENDCOUNTS,ISENDDISPL_PT,${proc["mpi_type"]}$,${proc["recvbuf"]}$,IRECVCOUNT,${proc["mpi_type"]}$,IROOT-1,ICOMM,IERROR)
ELSEIF(IMP_TYPE == JP_NON_BLOCKING_STANDARD .OR. IMP_TYPE == JP_NON_BLOCKING_BUFFERED) THEN
  CALL MPI_ISCATTERV(${proc["sendbuf"]}$,ISENDCOUNTS,ISENDDISPL_PT,${proc["mpi_type"]}$,${proc["recvbuf"]}$,IRECVCOUNT,${proc["mpi_type"]}$,IROOT-1,ICOMM,IREQUEST_LOCAL,IERROR)
  KREQUEST=IREQUEST_LOCAL%MPI_VAL
END IF

IF(LMPLSTATS) THEN
  CALL MPL_SENDSTATS(ISENDCOUNT,${proc["stats_type"]}$%MPI_VAL)
  CALL MPL_RECVSTATS(IRECVCOUNT,${proc["stats_type"]}$%MPI_VAL)
ENDIF

IF(PRESENT(KERROR)) THEN
  KERROR=IERROR
ELSE
  IF(IERROR /= 0 ) CALL MPL_MESSAGE(CDMESSAGE='MPL_SCATTERV',CDSTRING=CDSTRING,KERROR=IERROR,LDABORT=LLABORT)
ENDIF

END PROCEDURE MPL_SCATTERV_${proc["name"]}$

#:endfor

END SUBMODULE MPL_SCATTERV_IMPLEMENTATION_MOD
