SUBMODULE (MPL_GATHERV_MOD) MPL_GATHERV_IMPLEMENTATION_MOD

USE EC_PARKIND, ONLY : JPRD, JPIM, JPIB, JPRM
USE OML_MOD,    ONLY : OML_MY_THREAD

USE MPL_MPI,         ONLY : MPI_COMM, MPI_REQUEST, MPI_REAL4, MPI_REAL8, MPI_INTEGER, MPI_CHARACTER, &
 &                          MPI_GATHER, MPI_GATHERV, MPI_IGATHER, MPI_IGATHERV
USE MPL_DATA_MODULE, ONLY : MPL_COMM_OML, MPL_OUTPUT, MPL_UNIT, MPL_METHOD, MPL_NUMPROC, &
 &                          JP_BLOCKING_STANDARD, JP_BLOCKING_BUFFERED, JP_NON_BLOCKING_STANDARD, JP_NON_BLOCKING_BUFFERED
USE MPL_STATS_MOD,   ONLY : MPL_RECVSTATS, MPL_SENDSTATS
USE YOMMPLSTATS,     ONLY : LMPLSTATS
USE MPL_MESSAGE_MOD, ONLY : MPL_MESSAGE
USE MPL_DISPLS_CONTAINER_MOD, ONLY : YDDISPLS_LIST
USE MPL_WAIT_MOD,    ONLY : MPL_WAIT
USE MPL_MYRANK_MOD,  ONLY : MPL_MYRANK

IMPLICIT NONE

CONTAINS

SUBROUTINE MPL_GATHERV_PREAMB1(IERROR,IPL_NUMPROC,IPL_MYRANK,ICOMM,IROOT,IMP_TYPE, &
 & KCOMM,KROOT,KMP_TYPE,KREQUEST)
INTEGER(KIND=JPIM),INTENT(OUT) :: IERROR,IPL_NUMPROC,IPL_MYRANK,ICOMM,IROOT,IMP_TYPE
INTEGER(KIND=JPIM),INTENT(IN),OPTIONAL :: KCOMM,KROOT,KMP_TYPE,KREQUEST

INTEGER(KIND=JPIM) :: ITID
LOGICAL :: LLABORT=.TRUE.

ITID = OML_MY_THREAD()

IF(MPL_NUMPROC < 1) CALL MPL_MESSAGE( &
  & CDMESSAGE='MPL_GATHERV: MPL NOT INITIALISED ',LDABORT=LLABORT)

IF(PRESENT(KMP_TYPE)) THEN
  IMP_TYPE=KMP_TYPE
ELSE
  IMP_TYPE=MPL_METHOD
ENDIF

IF(PRESENT(KCOMM)) THEN
  ICOMM=KCOMM
ELSE
  ICOMM=MPL_COMM_OML(ITID)
ENDIF

IPL_NUMPROC=MPL_NUMPROC
IPL_MYRANK=MPL_MYRANK(ICOMM)
IF(PRESENT(KROOT)) THEN
  IROOT=KROOT
ELSE
  IROOT=1
ENDIF

IF(IROOT < 1 .OR. IROOT > IPL_NUMPROC) THEN
  CALL MPL_MESSAGE(CDMESSAGE='MPL_GATHERV: ILLEGAL KROOT ',LDABORT=LLABORT)
ENDIF

IF(IMP_TYPE == JP_NON_BLOCKING_STANDARD .AND. (.NOT. PRESENT(KREQUEST))) THEN
  CALL MPL_MESSAGE(CDMESSAGE='MPL_GATHERV:KREQUEST MISSING ',LDABORT=LLABORT)
ENDIF

END SUBROUTINE MPL_GATHERV_PREAMB1

SUBROUTINE MPL_GATHERV_PREAMB2(IPL_NUMPROC,IPL_MYRANK,IRECVBUFSIZE,ISENDCOUNT,&
 & IRECVCOUNTS,IRECVDISPL,IRECVDISPL_PT,IMP_TYPE,KRECVDISPL,CDSTRING)

INTEGER(KIND=JPIM),INTENT(IN) :: IPL_NUMPROC,IPL_MYRANK,IRECVBUFSIZE,ISENDCOUNT
INTEGER(KIND=JPIM),INTENT(INOUT) :: IRECVCOUNTS(:)
INTEGER(KIND=JPIM),ALLOCATABLE,TARGET,INTENT(INOUT) :: IRECVDISPL(:)
INTEGER(KIND=JPIM),POINTER,INTENT(INOUT) :: IRECVDISPL_PT(:)
INTEGER(KIND=JPIM),INTENT(IN) :: IMP_TYPE
INTEGER(KIND=JPIM),INTENT(IN),OPTIONAL,TARGET :: KRECVDISPL(:)
CHARACTER(LEN=*),INTENT(IN),OPTIONAL :: CDSTRING

INTEGER(KIND=JPIM) :: I
LOGICAL :: LLABORT=.TRUE.

IF(PRESENT(KRECVDISPL)) THEN
  ALLOCATE(IRECVDISPL(SIZE(KRECVDISPL)))
  IRECVDISPL = KRECVDISPL
  IRECVDISPL_PT => IRECVDISPL
ELSE
  ALLOCATE(IRECVDISPL(IPL_NUMPROC))
  IRECVDISPL(1) = 0
  DO I = 2,IPL_NUMPROC
    IRECVDISPL(I) = IRECVDISPL(I-1) + IRECVCOUNTS(I-1)
  END DO
  IRECVDISPL_PT => IRECVDISPL
ENDIF

IF(IMP_TYPE == JP_BLOCKING_STANDARD .OR. IMP_TYPE == JP_BLOCKING_BUFFERED) THEN
  IF(SUM(IRECVCOUNTS) > IRECVBUFSIZE) THEN
    CALL MPL_MESSAGE(CDMESSAGE='MPL_GATHERV: SIZE(PRECVBUF) too small',CDSTRING=CDSTRING,LDABORT=LLABORT)
  ENDIF
ENDIF

END SUBROUTINE MPL_GATHERV_PREAMB2

#:mute
#:set procs = [dict(name="REAL4", sendbuf="PSENDBUF", recvbuf="PRECVBUF", send_default="SIZE(PSENDBUF)", recvbuf_present="PRECVBUF", recvbuf_missing_msg="MPL_GATHERV:RECVBUF MISSING", recvbuf_size_expr="SIZE(PRECVBUF)", recvcounts_source="KRECVCOUNTS", mpi_type="MPI_REAL4", stats_type="MPI_REAL4", dummy_decl="REAL(KIND=JPRM)    :: ZDUM_JPRM(1:0)", dummy_name="ZDUM_JPRM"), dict(name="REAL8", sendbuf="PSENDBUF", recvbuf="PRECVBUF", send_default="SIZE(PSENDBUF)", recvbuf_present="PRECVBUF", recvbuf_missing_msg="MPL_GATHERV:RECVBUF MISSING", recvbuf_size_expr="SIZE(PRECVBUF)", recvcounts_source="KRECVCOUNTS", mpi_type="MPI_REAL8", stats_type="MPI_REAL8", dummy_decl="REAL(KIND=JPRD)    :: ZDUM_JPRD(1:0)", dummy_name="ZDUM_JPRD"), dict(name="INT", sendbuf="KSENDBUF", recvbuf="KRECVBUF", send_default="SIZE(KSENDBUF)", recvbuf_present="KRECVBUF", recvbuf_missing_msg="MPL_GATHERV:RECVBUF MISSING", recvbuf_size_expr="SIZE(KRECVBUF)", recvcounts_source="KRECVCOUNTS", mpi_type="MPI_INTEGER", stats_type="MPI_INTEGER", dummy_decl="INTEGER(KIND=JPIM) :: ZDUM_INT(1:0)", dummy_name="ZDUM_INT")]
#:endmute

#:for proc in procs
MODULE PROCEDURE MPL_GATHERV_${proc["name"]}$

#ifdef USE_8_BYTE_WORDS
USE MPI4TO8, ONLY : &
  MPI_GATHERV => MPI_GATHERV8, MPI_GATHER => MPI_GATHER8
#endif

INTEGER(KIND=JPIM) :: IRECVCOUNTS(MPL_NUMPROC)
INTEGER(KIND=JPIM),ALLOCATABLE,TARGET :: IRECVDISPL(:)
INTEGER(KIND=JPIM),POINTER :: IRECVDISPL_PT(:)
INTEGER(KIND=JPIM) :: IERROR,IPL_NUMPROC,IPL_MYRANK,IROOT,IMP_TYPE
TYPE(MPI_COMM)     :: ICOMM
TYPE(MPI_REQUEST)  :: IREQUEST_LOCAL
INTEGER(KIND=JPIM) :: IRECVBUFSIZE,ISENDCOUNT
${proc["dummy_decl"]}$
INTEGER(KIND=JPIM) :: ONES(1:0)
LOGICAL :: LLABORT=.TRUE.

IF(PRESENT(KSENDCOUNT)) THEN
  ISENDCOUNT = KSENDCOUNT
ELSE
  ISENDCOUNT = ${proc["send_default"]}$
ENDIF
CALL MPL_GATHERV_PREAMB1(IERROR,IPL_NUMPROC,IPL_MYRANK,ICOMM%MPI_VAL,IROOT,IMP_TYPE,KCOMM,KROOT,KMP_TYPE,KREQUEST)

IF(IPL_MYRANK == IROOT) THEN
  IF( .NOT. PRESENT(${proc["recvbuf_present"]}$)) CALL MPL_MESSAGE(&
    & CDMESSAGE='${proc["recvbuf_missing_msg"]}$',CDSTRING=CDSTRING,LDABORT=LLABORT)
  IRECVBUFSIZE = ${proc["recvbuf_size_expr"]}$
  IF(PRESENT(KRECVDISPL)) THEN
    IRECVCOUNTS=${proc["recvcounts_source"]}$
    CALL MPL_GATHERV_PREAMB2(IPL_NUMPROC,IPL_MYRANK,IRECVBUFSIZE,ISENDCOUNT,&
      & IRECVCOUNTS,IRECVDISPL,IRECVDISPL_PT,IMP_TYPE,KRECVDISPL,CDSTRING)
    IF(IMP_TYPE == JP_BLOCKING_STANDARD .OR. IMP_TYPE == JP_BLOCKING_BUFFERED) THEN
      CALL MPI_GATHERV(${proc["sendbuf"]}$,ISENDCOUNT,${proc["mpi_type"]}$,${proc["recvbuf"]}$,&
        & IRECVCOUNTS,IRECVDISPL_PT,${proc["mpi_type"]}$,IROOT-1,ICOMM,IERROR)
    ELSEIF(IMP_TYPE == JP_NON_BLOCKING_STANDARD .OR. IMP_TYPE == JP_NON_BLOCKING_BUFFERED) THEN
      CALL MPI_IGATHERV(${proc["sendbuf"]}$,ISENDCOUNT,${proc["mpi_type"]}$,${proc["recvbuf"]}$,&
        & IRECVCOUNTS,IRECVDISPL_PT,${proc["mpi_type"]}$,IROOT-1,ICOMM,IREQUEST_LOCAL,IERROR)
      KREQUEST=IREQUEST_LOCAL%MPI_VAL
      IF(.NOT. PRESENT(KRECVDISPL)) THEN
        CALL YDDISPLS_LIST%APPEND(KREQ=KREQUEST,NO_NEW_NODE=.TRUE.)
      ENDIF
    ENDIF
    IF(LMPLSTATS) THEN
      CALL MPL_SENDSTATS(ISENDCOUNT,${proc["stats_type"]}$%MPI_VAL)
      CALL MPL_RECVSTATS(SUM(IRECVCOUNTS),${proc["stats_type"]}$%MPI_VAL)
    ENDIF
  ELSE
    IF(IRECVBUFSIZE < IPL_NUMPROC) THEN
      CALL MPL_MESSAGE(CDMESSAGE='MPL_GATHERV:IRECVBUFSIZE < IPL_NUMPROC',&
        & CDSTRING=CDSTRING,LDABORT=LLABORT)
    ENDIF
    IF(IMP_TYPE == JP_BLOCKING_STANDARD .OR. IMP_TYPE == JP_BLOCKING_BUFFERED) THEN
      CALL MPI_GATHER(${proc["sendbuf"]}$,ISENDCOUNT,${proc["mpi_type"]}$,${proc["recvbuf"]}$,&
        & ISENDCOUNT,${proc["mpi_type"]}$,IROOT-1,ICOMM,IERROR)
    ELSEIF(IMP_TYPE == JP_NON_BLOCKING_STANDARD .OR. IMP_TYPE == JP_NON_BLOCKING_BUFFERED) THEN
      CALL MPI_IGATHER(${proc["sendbuf"]}$,ISENDCOUNT,${proc["mpi_type"]}$,${proc["recvbuf"]}$,&
        & ISENDCOUNT,${proc["mpi_type"]}$,IROOT-1,ICOMM,IREQUEST_LOCAL,IERROR)
      KREQUEST=IREQUEST_LOCAL%MPI_VAL
      CALL MPL_WAIT(IREQUEST_LOCAL)
    ENDIF
    IF(LMPLSTATS) THEN
      CALL MPL_SENDSTATS(ISENDCOUNT,${proc["stats_type"]}$%MPI_VAL)
      CALL MPL_RECVSTATS(ISENDCOUNT,${proc["stats_type"]}$%MPI_VAL)
    ENDIF
  ENDIF
ELSE
  IF(PRESENT(KRECVDISPL)) THEN
    IF(IMP_TYPE == JP_BLOCKING_STANDARD .OR. IMP_TYPE == JP_BLOCKING_BUFFERED) THEN
      CALL MPI_GATHERV(${proc["sendbuf"]}$,ISENDCOUNT,${proc["mpi_type"]}$,${proc["dummy_name"]}$,ONES, &
       &  ONES,${proc["mpi_type"]}$,IROOT-1,ICOMM,IERROR)
    ELSEIF(IMP_TYPE == JP_NON_BLOCKING_STANDARD .OR. IMP_TYPE == JP_NON_BLOCKING_BUFFERED) THEN
      CALL MPI_IGATHERV(${proc["sendbuf"]}$,ISENDCOUNT,${proc["mpi_type"]}$,${proc["dummy_name"]}$,ONES, &
       &  ONES,${proc["mpi_type"]}$,IROOT-1,ICOMM,IREQUEST_LOCAL,IERROR)
      KREQUEST=IREQUEST_LOCAL%MPI_VAL
      IF(.NOT. PRESENT(KRECVDISPL)) THEN
        CALL YDDISPLS_LIST%APPEND(KREQ=KREQUEST,NO_NEW_NODE=.TRUE.)
      ENDIF
    ENDIF
    IF(LMPLSTATS) THEN
      CALL MPL_SENDSTATS(ISENDCOUNT,${proc["stats_type"]}$%MPI_VAL)
    ENDIF
  ELSE
    IF(IMP_TYPE == JP_BLOCKING_STANDARD .OR. IMP_TYPE == JP_BLOCKING_BUFFERED) THEN
      CALL MPI_GATHER(${proc["sendbuf"]}$,ISENDCOUNT,${proc["mpi_type"]}$,${proc["dummy_name"]}$,&
        & 1,${proc["mpi_type"]}$,IROOT-1,ICOMM,IERROR)
    ELSEIF(IMP_TYPE == JP_NON_BLOCKING_STANDARD .OR. IMP_TYPE == JP_NON_BLOCKING_BUFFERED) THEN
      CALL MPI_IGATHER(${proc["sendbuf"]}$,ISENDCOUNT,${proc["mpi_type"]}$,${proc["dummy_name"]}$,&
        & 1,${proc["mpi_type"]}$,IROOT-1,ICOMM,IREQUEST_LOCAL,IERROR)
      KREQUEST=IREQUEST_LOCAL%MPI_VAL
    ENDIF
    IF(LMPLSTATS) THEN
      CALL MPL_SENDSTATS(ISENDCOUNT,${proc["stats_type"]}$%MPI_VAL)
    ENDIF
  ENDIF
ENDIF

IF(PRESENT(KERROR)) THEN
  KERROR=IERROR
ELSE
  IF(IERROR /= 0 ) CALL MPL_MESSAGE( &
 &        CDMESSAGE='MPL_GATHERV',CDSTRING=CDSTRING,&
 &        KERROR=IERROR,LDABORT=LLABORT)
ENDIF

END PROCEDURE MPL_GATHERV_${proc["name"]}$

#:endfor

#:mute
#:set scalar_procs = [dict(name="CHAR_SCALAR", sendbuf="CSENDBUF", recvbuf="CRECVBUF", send_default="LEN(CSENDBUF)", recvbuf_present="CRECVBUF", recvbuf_missing_msg="MPL_GATHERV:RECVBUF MISSING", recvbuf_size_expr="LEN(CRECVBUF)*SIZE(CRECVBUF)", recvcounts_assign="KRECVCOUNTS", mpi_type="MPI_CHARACTER", stats_type="MPI_CHARACTER", dummy_decl="CHARACTER(LEN=1)   :: ZDUM_CHAR(1:0)", dummy_name="ZDUM_CHAR", contig_check=True, has_sendcount=True), dict(name="INT_SCALAR", sendbuf="KSENDBUF", recvbuf="KRECVBUF", send_default="1", recvbuf_present="KRECVBUF", recvbuf_missing_msg="MPL_GATHERV:RECVBUF MISSING", recvbuf_size_expr="SIZE(KRECVBUF)", recvcounts_assign="KRECVCOUNTS", mpi_type="MPI_INTEGER", stats_type="MPI_INTEGER", dummy_decl="INTEGER(KIND=JPIM) :: ZDUM_INT(1:0)", dummy_name="ZDUM_INT", contig_check=False, has_sendcount=True), dict(name="REAL8_SCALAR", sendbuf="PSENDBUF", recvbuf="PRECVBUF", send_default="1", recvbuf_present="PRECVBUF", recvbuf_missing_msg="MPL_GATHERV:RECVBUF MISSING", recvbuf_size_expr="SIZE(PRECVBUF)", recvcounts_assign="1", mpi_type="MPI_REAL8", stats_type="MPI_REAL8", dummy_decl="REAL(KIND=JPRD)    :: ZDUM_JPRD(1:0)", dummy_name="ZDUM_JPRD", contig_check=False, has_sendcount=False)]
#:endmute

#:for proc in scalar_procs
MODULE PROCEDURE MPL_GATHERV_${proc["name"]}$

#ifdef USE_8_BYTE_WORDS
USE MPI4TO8, ONLY : &
  MPI_GATHERV => MPI_GATHERV8, MPI_GATHER => MPI_GATHER8
#endif

INTEGER(KIND=JPIM),ALLOCATABLE,TARGET :: IRECVDISPL(:)
INTEGER(KIND=JPIM),POINTER :: IRECVDISPL_PT(:)
INTEGER(KIND=JPIM) :: IERROR,IPL_NUMPROC,IPL_MYRANK,IROOT,IMP_TYPE
INTEGER(KIND=JPIM) :: IRECVBUFSIZE,ISENDCOUNT
TYPE(MPI_COMM)     :: ICOMM
TYPE(MPI_REQUEST)  :: IREQUEST_LOCAL
${proc["dummy_decl"]}$
INTEGER(KIND=JPIM) :: ONES(1:0)
INTEGER(KIND=JPIM) :: IRECVCOUNTS(MPL_NUMPROC)
LOGICAL :: LLABORT=.TRUE.

#:if proc["has_sendcount"]
IF(PRESENT(KSENDCOUNT)) THEN
  ISENDCOUNT=KSENDCOUNT
ELSE
  ISENDCOUNT = ${proc["send_default"]}$
ENDIF
#:else
ISENDCOUNT = ${proc["send_default"]}$
#:endif
CALL MPL_GATHERV_PREAMB1(IERROR,IPL_NUMPROC,IPL_MYRANK,ICOMM%MPI_VAL, &
 &                       IROOT,IMP_TYPE,KCOMM,KROOT,KMP_TYPE,KREQUEST)

IF(IPL_MYRANK == IROOT) THEN
  IF( .NOT. PRESENT(${proc["recvbuf_present"]}$)) CALL MPL_MESSAGE(&
    & CDMESSAGE='${proc["recvbuf_missing_msg"]}$',CDSTRING=CDSTRING,LDABORT=LLABORT)
  IRECVBUFSIZE = ${proc["recvbuf_size_expr"]}$
 #:if proc["contig_check"]
#ifdef MPL_CHECK_CONTIG
  IF( .NOT. IS_CONTIGUOUS(${proc["recvbuf"]}$) ) THEN
    CALL MPL_MESSAGE(CDMESSAGE='MPL_GATHERV: RECVBUF NOT CONTIGUOUS ',LDABORT=LLABORT)
  ENDIF
#endif
 #:endif
  IF(PRESENT(KRECVDISPL)) THEN
    #:if proc["recvcounts_assign"] == "1"
    IRECVCOUNTS(:) = 1
    #:else
    IRECVCOUNTS=KRECVCOUNTS
    #:endif
    CALL MPL_GATHERV_PREAMB2(IPL_NUMPROC,IPL_MYRANK,IRECVBUFSIZE,ISENDCOUNT,&
      & IRECVCOUNTS,IRECVDISPL,IRECVDISPL_PT,IMP_TYPE,KRECVDISPL,CDSTRING)
    IF(IMP_TYPE == JP_BLOCKING_STANDARD .OR. IMP_TYPE == JP_BLOCKING_BUFFERED) THEN
      CALL MPI_GATHERV(${proc["sendbuf"]}$,ISENDCOUNT,${proc["mpi_type"]}$,${proc["recvbuf"]}$,IRECVCOUNTS,&
        &  IRECVDISPL_PT,${proc["mpi_type"]}$,IROOT-1,ICOMM,IERROR)
    ELSEIF(IMP_TYPE == JP_NON_BLOCKING_STANDARD .OR. IMP_TYPE == JP_NON_BLOCKING_BUFFERED) THEN
      CALL MPI_IGATHERV(${proc["sendbuf"]}$,ISENDCOUNT,${proc["mpi_type"]}$,${proc["recvbuf"]}$,IRECVCOUNTS,&
        &  IRECVDISPL_PT,${proc["mpi_type"]}$,IROOT-1,ICOMM,IREQUEST_LOCAL,IERROR)
      KREQUEST=IREQUEST_LOCAL%MPI_VAL
      IF(.NOT. PRESENT(KRECVDISPL)) THEN
        CALL YDDISPLS_LIST%APPEND(KREQ=KREQUEST,NO_NEW_NODE=.TRUE.)
      ENDIF
    ENDIF
    IF(LMPLSTATS) THEN
      CALL MPL_SENDSTATS(ISENDCOUNT,${proc["stats_type"]}$%MPI_VAL)
      CALL MPL_RECVSTATS(SUM(IRECVCOUNTS),${proc["stats_type"]}$%MPI_VAL)
    ENDIF
  ELSE
    IF(IRECVBUFSIZE < IPL_NUMPROC) THEN
      CALL MPL_MESSAGE(CDMESSAGE='MPL_GATHERV:IRECVBUFSIZE < IPL_NUMPROC',&
        & CDSTRING=CDSTRING,LDABORT=LLABORT)
    ENDIF
    IF(IMP_TYPE == JP_BLOCKING_STANDARD .OR. IMP_TYPE == JP_BLOCKING_BUFFERED) THEN
      CALL MPI_GATHER(${proc["sendbuf"]}$,ISENDCOUNT,${proc["mpi_type"]}$,${proc["recvbuf"]}$, &
        &  ISENDCOUNT,${proc["mpi_type"]}$,IROOT-1,ICOMM,IERROR)
    ELSEIF(IMP_TYPE == JP_NON_BLOCKING_STANDARD .OR. IMP_TYPE == JP_NON_BLOCKING_BUFFERED) THEN
      CALL MPI_IGATHER(${proc["sendbuf"]}$,ISENDCOUNT,${proc["mpi_type"]}$,${proc["recvbuf"]}$, &
        &  ISENDCOUNT,${proc["mpi_type"]}$,IROOT-1,ICOMM,IREQUEST_LOCAL,IERROR)
      KREQUEST=IREQUEST_LOCAL%MPI_VAL
      CALL MPL_WAIT(IREQUEST_LOCAL)
    ENDIF
    IF(LMPLSTATS) THEN
      CALL MPL_SENDSTATS(ISENDCOUNT,${proc["stats_type"]}$%MPI_VAL)
      CALL MPL_RECVSTATS(ISENDCOUNT,${proc["stats_type"]}$%MPI_VAL)
    ENDIF
  ENDIF
ELSE
  IF(PRESENT(KRECVDISPL)) THEN
    IF(IMP_TYPE == JP_BLOCKING_STANDARD .OR. IMP_TYPE == JP_BLOCKING_BUFFERED) THEN
      CALL MPI_GATHERV(${proc["sendbuf"]}$,ISENDCOUNT,${proc["mpi_type"]}$,${proc["dummy_name"]}$,ONES, &
        &  ONES,${proc["mpi_type"]}$,IROOT-1,ICOMM,IERROR)
    ELSEIF(IMP_TYPE == JP_NON_BLOCKING_STANDARD .OR. IMP_TYPE == JP_NON_BLOCKING_BUFFERED) THEN
      CALL MPI_IGATHERV(${proc["sendbuf"]}$,ISENDCOUNT,${proc["mpi_type"]}$,${proc["dummy_name"]}$,ONES, &
        &  ONES,${proc["mpi_type"]}$,IROOT-1,ICOMM,IREQUEST_LOCAL,IERROR)
      KREQUEST=IREQUEST_LOCAL%MPI_VAL
    ENDIF
    IF(LMPLSTATS) THEN
      CALL MPL_SENDSTATS(ISENDCOUNT,${proc["stats_type"]}$%MPI_VAL)
    ENDIF
  ELSE
    IF(IMP_TYPE == JP_BLOCKING_STANDARD .OR. IMP_TYPE == JP_BLOCKING_BUFFERED) THEN
      CALL MPI_GATHER(${proc["sendbuf"]}$,ISENDCOUNT,${proc["mpi_type"]}$,${proc["dummy_name"]}$, &
        & 1,${proc["mpi_type"]}$,IROOT-1,ICOMM,IERROR)
    ELSEIF(IMP_TYPE == JP_NON_BLOCKING_STANDARD .OR. IMP_TYPE == JP_NON_BLOCKING_BUFFERED) THEN
      CALL MPI_IGATHER(${proc["sendbuf"]}$,ISENDCOUNT,${proc["mpi_type"]}$,${proc["dummy_name"]}$, &
        & 1,${proc["mpi_type"]}$,IROOT-1,ICOMM,IREQUEST_LOCAL,IERROR)
      KREQUEST=IREQUEST_LOCAL%MPI_VAL
    ENDIF
    IF(LMPLSTATS) THEN
      CALL MPL_SENDSTATS(ISENDCOUNT,${proc["stats_type"]}$%MPI_VAL)
    ENDIF
  ENDIF
ENDIF

IF(PRESENT(KERROR)) THEN
  KERROR=IERROR
ELSE
  IF(IERROR /= 0 ) CALL MPL_MESSAGE( &
 &        CDMESSAGE='MPL_GATHERV',CDSTRING=CDSTRING,&
 &        KERROR=IERROR,LDABORT=LLABORT)
ENDIF

END PROCEDURE MPL_GATHERV_${proc["name"]}$

#:endfor

END SUBMODULE MPL_GATHERV_IMPLEMENTATION_MOD
